{
	"minimumDependencyAge": 0, // WTH IS THIS, DONT WE HAVE DENO PERMISSIONS ALREADY????
	"workspace": [
		"project/app",
		"project/shared/codecs",
		"project/shared/utils",
		"project/shared/libs/bytes",
		"project/shared/libs/collections",
		"project/shared/libs/bitcoin",
		"project/shared/libs/hashes",
		"project/shared/libs/formatting",
		"project/shared/libs/message"
	],
	"imports": {
		"@noble/curves": "jsr:@noble/curves@1.9.0",
		"@noble/hashes": "jsr:@noble/hashes@1.8.0",
		"@noble/secp256k1": "jsr:@noble/secp256k1@2.3.0",
		"@nomadshiba/codec": "jsr:@nomadshiba/codec@0.5.2-preview.3",
		"@nomadshiba/mmap": "jsr:@nomadshiba/mmap@^0.0.8",
		"@purifyjs/core": "jsr:@purifyjs/core@0.5.1",
		"@std/assert": "jsr:@std/assert@^1.0.19",
		"@std/async": "jsr:@std/async@^1.3.0",
		"@std/bytes": "jsr:@std/bytes@1.0.6",
		"@std/cli": "jsr:@std/cli@^1.0.30",
		"@std/encoding": "jsr:@std/encoding@1.0.10",
		"@std/fs": "jsr:@std/fs@1.0.19",
		"@std/http": "jsr:@std/http@^1.1.0",
		"@std/path": "jsr:@std/path@1.1.2",
		"@std/streams": "jsr:@std/streams@1.0.12",
		"@std/uuid": "jsr:@std/uuid@^1.1.1",
		"@webview/webview": "jsr:@webview/webview@^0.9.0",
		"@ungap/custom-elements": "https://esm.sh/@ungap/custom-elements"
	},
	"tasks": {
		"test": "deno test -A project",
		"check": "deno check project && deno lint project && deno task test",
		"bundle": "deno bundle --output=project/app/frontend/dist/app.js project/app/frontend/app.ts", // or add --watch
		"start": "deno run --v8-flags=--expose-gc -A project/app/main.ts", // or add --watch
		"inspect": "deno run --v8-flags=--expose-gc -A --inspect-brk project/app/main.ts",
		"profile": "deno run --v8-flags=--expose-gc -A --cpu-prof project/app/main.ts",
		"compile": "deno compile -A --output=out/bitcoin project/app/main.ts"
	},
	"unstable": ["raw-imports"],
	"compilerOptions": {
		"lib": ["esnext", "deno.ns", "deno.window", "deno.unstable", "deno.worker"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"useUnknownInCatchVariables": true
	},
	"fmt": {
		"lineWidth": 140,
		"indentWidth": 4,
		"useTabs": true
	},
	"lint": {
		"plugins": ["./plugins/strict_classes.ts", "./plugins/imports.ts"],
		"rules": {
			"exclude": [
				"no-namespace",
				"no-explicit-any",
				"ban-types",
				"require-await",
				"no-inner-declarations",
				"no-slow-types",
				"verbatim-module-syntax"
			]
		}
	}
}
